# ==========================================
# 智能家居微服务 Docker 部署环境变量
# ==========================================

# MySQL
MYSQL_ROOT_PASSWORD=smart_home_root_2024
MYSQL_DATABASE=smart_home
MYSQL_USER=admin
MYSQL_PASSWORD=smart_home_admin_2024
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=smart_home_mq_2024
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Eureka
EUREKA_PORT=8761

# API Gateway
API_GATEWAY_PORT=8080

# Device Service
DEVICE_SERVICE_PORT=8081

# User Service
USER_SERVICE_PORT=8082

# Scene Service
SCENE_SERVICE_PORT=8083

# Edge Service
EDGE_SERVICE_PORT=8084
EDGE_GRPC_PORT=9094

# Analytics Service
ANALYTICS_SERVICE_PORT=8085

# Multimodal Service
MULTIMODAL_SERVICE_PORT=8089

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# Frontend
FRONTEND_PORT=3001

# JVM 内存配置
JAVA_OPTS_EUREKA=-Xms128m -Xmx256m
JAVA_OPTS_GATEWAY=-Xms256m -Xmx512m
JAVA_OPTS_DEVICE=-Xms256m -Xmx512m
JAVA_OPTS_USER=-Xms256m -Xmx512m
JAVA_OPTS_SCENE=-Xms256m -Xmx512m
JAVA_OPTS_EDGE=-Xms256m -Xmx768m
JAVA_OPTS_ANALYTICS=-Xms256m -Xmx1024m
JAVA_OPTS_MULTIMODAL=-Xms256m -Xmx768m