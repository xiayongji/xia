# ==========================================
# 智能家居微服务 - 树莓派 Docker 部署环境变量
# ==========================================
# 适配树莓派 5 (8GB) / 树莓派 4 (4GB)
# 如用 Pi 4 (4GB)，建议关闭 edge-service 和 multimodal-service

# ==========================================
# 数据库选择：推荐 MariaDB（ARM 原生优化更好）
# ==========================================
DATABASE_IMAGE=mariadb:10.11
# 备选：MYSQL_IMAGE=mysql:8.0

# ==========================================
# MySQL / MariaDB
# ==========================================
MYSQL_ROOT_PASSWORD=smart_home_root_2024
MYSQL_DATABASE=smart_home
MYSQL_USER=admin
MYSQL_PASSWORD=smart_home_admin_2024
MYSQL_PORT=3306

# ==========================================
# Redis
# ==========================================
REDIS_PORT=6379
REDIS_MAXMEMORY=64mb

# ==========================================
# RabbitMQ
# ==========================================
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=smart_home_mq_2024
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ==========================================
# 服务端口
# ==========================================
EUREKA_PORT=8761
API_GATEWAY_PORT=8080
DEVICE_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
SCENE_SERVICE_PORT=8083
EDGE_SERVICE_PORT=8084
EDGE_GRPC_PORT=9094
ANALYTICS_SERVICE_PORT=8085
MULTIMODAL_SERVICE_PORT=8089

# ==========================================
# 监控 (可选，降低 Pi 负载时注释掉)
# ==========================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# ==========================================
# 前端
# ==========================================
FRONTEND_PORT=80

# ==========================================
# JVM 内存配置（树莓派 8GB 优化值）
# Pi 4 (4GB): 所有值再减半
# ==========================================
# Eureka 注册中心（最轻量）
JAVA_OPTS_EUREKA=-Xms64m -Xmx128m -XX:+UseSerialGC -XX:MaxRAMPercentage=50.0

# API 网关（IO 密集型）
JAVA_OPTS_GATEWAY=-Xms128m -Xmx256m -XX:+UseSerialGC -XX:MaxRAMPercentage=60.0

# 设备服务
JAVA_OPTS_DEVICE=-Xms128m -Xmx256m -XX:+UseSerialGC -XX:MaxRAMPercentage=60.0

# 用户服务
JAVA_OPTS_USER=-Xms128m -Xmx256m -XX:+UseSerialGC -XX:MaxRAMPercentage=60.0

# 场景服务
JAVA_OPTS_SCENE=-Xms128m -Xmx256m -XX:+UseSerialGC -XX:MaxRAMPercentage=60.0

# 边缘服务（含 gRPC）
JAVA_OPTS_EDGE=-Xms128m -Xmx384m -XX:+UseSerialGC -XX:MaxRAMPercentage=60.0

# 分析服务（计算密集型，给大一点）
JAVA_OPTS_ANALYTICS=-Xms128m -Xmx512m -XX:+UseSerialGC -XX:MaxRAMPercentage=65.0

# 多模态服务
JAVA_OPTS_MULTIMODAL=-Xms128m -Xmx384m -XX:+UseSerialGC -XX:MaxRAMPercentage=60.0

# ==========================================
# 构建模式（Pi 上推荐 native 本地构建）
# ==========================================
# BUILD_MODE=registry  # 从 ghcr.io 拉取预构建镜像
# BUILD_MODE=native     # Pi 本地 Maven 构建（首次约 20-30 分钟）
BUILD_MODE=native

# ==========================================
# Registry 配置（仅 BUILD_MODE=registry 时需要）
# ==========================================
REGISTRY=ghcr.io
REPO_OWNER=你的GitHub用户名