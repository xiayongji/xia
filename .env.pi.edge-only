# ==========================================
# 树莓派边缘计算专用 - 最小化环境变量
# ==========================================
# 仅运行 edge-service + 必要基础设施

# MariaDB
MYSQL_ROOT_PASSWORD=smart_home_root_2024
MYSQL_DATABASE=smarthome_edge
MYSQL_USER=admin
MYSQL_PASSWORD=smart_home_admin_2024
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379
REDIS_MAXMEMORY=64mb

# Edge Service
EDGE_SERVICE_PORT=8084
EDGE_GRPC_PORT=9094

# JVM 内存配置（Pi 优化）
JAVA_OPTS_EDGE=-Xms128m -Xmx256m -XX:+UseSerialGC -XX:MaxRAMPercentage=50.0